{
    "name": "wpbrewer/wpbr-updater",
    "description": "WordPress plugin update client for the WPBrewer license server.",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "homepage": "https://github.com/WPBrewer/wpbr-updater",
    "require": {
        "php": ">=7.4",
        "ext-hash": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "opis/json-schema": "^2.4",
        "php-stubs/wordpress-stubs": "^7.1",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^9.6",
        "wp-phpunit/wp-phpunit": "7.1.3",
        "yoast/phpunit-polyfills": "^2.0 || ^3.0"
    },
    "suggest": {
        "ext-intl": "Required to normalize internationalized domain names the same way the license server does."
    },
    "autoload": {
        "psr-4": {
            "WPBrewer\\Updater\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WPBrewer\\Updater\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "7.4.33"
        },
        "allow-plugins": {
            "roots/wordpress-core-installer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --no-progress --memory-limit=1G"
    }
}
