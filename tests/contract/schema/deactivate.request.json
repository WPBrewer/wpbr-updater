{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://wpbrewer.com/schema/wpbr-license/v1/deactivate.request.json",
    "title": "POST /deactivate request",
    "type": "object",
    "additionalProperties": false,
    "required": ["instance_token", "domain", "product_slug"],
    "properties": {
        "instance_token": {
            "type": "string",
            "minLength": 32,
            "maxLength": 255,
            "pattern": "^[A-Za-z0-9_-]+$"
        },
        "domain": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
        },
        "product_slug": {
            "$ref": "https://wpbrewer.com/schema/wpbr-license/v1/slug.schema.json"
        }
    }
}
